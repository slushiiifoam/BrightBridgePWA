# Supabase project URL used by the server-side journal function.
SUPABASE_URL=https://your-project.supabase.co

# Modern public key used for the prototype. Supabase RLS must protect the tables.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key
# Resource assistant (netlify/functions/assistant.mjs)
ANTHROPIC_API_KEY=sk-ant-replace_with_your_key
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_DAILY_LIMIT=5
# OPENALEX_MAILTO=team@example.com
